# Carpetas y archivos que generan el pyinstaller
/build/
/dist/

# Carpetas de desarrollo
.idea/
.venv/

# Caché de Python
__pycache__/

# DLLs de lib/ fuera de versionado (se regeneran con tools/update_libs.py);
# .gitkeep se versiona para que la carpeta exista en clones frescos
/lib/*
!/lib/.gitkeep
